<?xml version="1.0"?>
<!--
  test_parcel — kırmızı mühürlü test kolisi (spesifikasyon 2.4)
  - Küp 0.20 m, 0.5 kg, kahverengi.
  - Mühür: -x yüzünde (robota bakan yüz) ortalanmış 0.10 × 0.10 m, 0.002 m
    kalınlığında ayrı görsel; çarpışması yoktur (fiziği etkilemez).
  - Atalet: dolu küp, I = m (a² + a²) / 12 = 0.5 · 0.08 / 12 = 3.3333e-3 kg·m².
  - Sürtünme mu = 1.0: DART min(μA, μB) birleştirdiği için koli–çatal temasını
    çatalın değeri (1.0) belirler (DECISIONS D-15).
-->
<sdf version="1.11">
  <model name="test_parcel">
    <link name="parcel_link">
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>3.3333333e-3</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>3.3333333e-3</iyy><iyz>0</iyz>
          <izz>3.3333333e-3</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="box_visual">
        <geometry><box><size>0.20 0.20 0.20</size></box></geometry>
        <material>
          <ambient>0.45 0.30 0.15 1</ambient>
          <diffuse>0.55 0.36 0.18 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <!-- mühür: iç yüzü koli yüzüyle aynı hizada, 2 mm dışarı taşar -->
      <visual name="seal_visual">
        <pose>-0.101 0 0 0 0 0</pose>
        <geometry><box><size>0.002 0.10 0.10</size></box></geometry>
        <material>
          <ambient>0.70 0.04 0.04 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
