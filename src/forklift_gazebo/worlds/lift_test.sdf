<?xml version="1.0"?>
<!--
  lift_test.sdf — forklift kaldırma test dünyası (spesifikasyon bölüm 3-4)
  - Fizik: varsayılan motor (DART, Physics sistemi seçer), adım 0.001 s, RTF 1.0
  - Sistemler: Physics, UserCommands, SceneBroadcaster, Sensors (ogre2)
  - Işık: 1 yönlü (güneş) + farklı açılarda 2 spot; hepsi gölge düşürür.
    Değişken aydınlatma, ileride CV'yi zorlamak için kasıtlıdır.
  - Nesneler: düz mat gri zemin, x = 1.5'te statik ray çifti ve üzerinde
    mühürlü koli (mühür -x yüzünde, robota bakar). Başka nesne yok.
    Robot launch dosyası tarafından orijine, +x'e bakacak şekilde spawn edilir.
  Ray ve koli ölçüleri spesifikasyon 2.4'tendir; bu dosya ve
  models/test_parcel/model.sdf bu nesnelerin tek kaynağıdır (kabul testi
  değerleri buradan okur).
-->
<sdf version="1.11">
  <world name="lift_test">

    <!-- motor seçimi Physics sistemine aittir (varsayılan gz-physics-dartsim) -->
    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.70 0.72 0.75 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- yönlü ışık: eğik güneş -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.75 0.75 0.72 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <direction>-0.4 0.25 -1.0</direction>
    </light>

    <!-- spot 1: sol-arkadan koli bölgesine -->
    <light type="spot" name="spot_left">
      <pose>0.5 1.6 2.2 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.60 0.60 0.58 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <attenuation>
        <range>8.0</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>1.0 -1.6 -2.0</direction>
      <spot>
        <inner_angle>0.5</inner_angle>
        <outer_angle>0.9</outer_angle>
        <falloff>1.0</falloff>
      </spot>
    </light>

    <!-- spot 2: sağ-önden robot bölgesine -->
    <light type="spot" name="spot_right">
      <pose>2.6 -1.4 1.8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.55 0.56 0.60 1</diffuse>
      <specular>0.20 0.20 0.20 1</specular>
      <attenuation>
        <range>8.0</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
      <direction>-1.8 1.4 -1.8</direction>
      <spot>
        <inner_angle>0.5</inner_angle>
        <outer_angle>0.9</outer_angle>
        <falloff>1.0</falloff>
      </spot>
    </light>

    <!-- düz, mat gri zemin; mu = 1.0 (DART min(μA, μB) birleştirir, DECISIONS D-15) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.50 0.50 0.50 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr><metal><metalness>0.0</metalness><roughness>1.0</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- destek rayları: her biri 0.20 (x) × 0.03 (y) × 0.05 (z), koli merkezine
         göre y = ±0.095 (iç açıklık 0.16 m) -->
    <model name="parcel_rails">
      <static>true</static>
      <pose>1.5 0 0 0 0 0</pose>
      <link name="rails_link">
        <collision name="left_rail_collision">
          <pose>0 0.095 0.025 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.05</size></box></geometry>
        </collision>
        <visual name="left_rail_visual">
          <pose>0 0.095 0.025 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.05</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.28 0.28 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="right_rail_collision">
          <pose>0 -0.095 0.025 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.05</size></box></geometry>
        </collision>
        <visual name="right_rail_visual">
          <pose>0 -0.095 0.025 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.05</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.28 0.28 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- mühürlü koli: taban z = 0.05 (ray üstü) → merkez z = 0.15 -->
    <include>
      <uri>model://test_parcel</uri>
      <name>test_parcel</name>
      <pose>1.5 0 0.15 0 0 0</pose>
    </include>

  </world>
</sdf>
