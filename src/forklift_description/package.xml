<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>forklift_description</name>
  <version>0.1.0</version>
  <description>
    Simulator-agnostic, modular xacro description of a small forklift robot used as a
    computer-vision learning platform. All dimensions, masses, limits and sensor
    parameters live in config/forklift_params.yaml.
  </description>
  <maintainer email="muhammetclsz61@gmail.com">muhammet61</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>python3-pil</build_depend>
  <build_depend>python3-yaml</build_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- gz: URDF'teki package://forklift_description/... → model://forklift_description/...;
         share dizini GZ_SIM_RESOURCE_PATH'e eklenir (ros_gz_sim gz_sim.launch.py) -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
