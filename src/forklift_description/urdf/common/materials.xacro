<?xml version="1.0"?>
<!--
  materials.xacro
  Görsel renkler (yalnızca <visual>). Fiziksel parametre içermez.
  Not: Robotun kameraların görebileceği parçaları (çatallar, taşıyıcı) koli
  mühür renklerinden (kırmızı / yeşil / mavi) bilinçli olarak uzak tutuldu.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="forklift_yellow"><color rgba="0.95 0.72 0.08 1.0"/></material>
  <material name="forklift_dark_grey"><color rgba="0.20 0.20 0.22 1.0"/></material>
  <material name="forklift_steel"><color rgba="0.55 0.56 0.60 1.0"/></material>
  <material name="forklift_rubber"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="forklift_camera"><color rgba="0.10 0.10 0.12 1.0"/></material>
</robot>
